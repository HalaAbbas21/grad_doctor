# Copy to .env.local and adjust as needed.

# Direct URL (try this first):
VITE_API_BASE_URL=http://api.basma-unit.cloud:8080/api
# If the browser reports a CORS error, switch to the Vite dev proxy instead:
# VITE_API_BASE_URL=/api

# Feature screens keep reading mock data regardless of auth being live.
VITE_USE_MOCK=true
